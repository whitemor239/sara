DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1, sara.whitemorvarid.ir
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=1
# Set to the public HTTPS origin when deployed, e.g. https://tastytum.example
ZARINPAL_CALLBACK_BASE_URL=http://127.0.0.1:8000
# Production-only: keep HSTS enabled only when the domain is permanently HTTPS.
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_HSTS_INCLUDE_SUBDOMAINS=0
OTP_SMS_BACKEND=console
KAVENEGAR_API_KEY=
KAVENEGAR_VERIFY_TEMPLATE=
